    print("密钥内容：", UPLOAD_KEY)
    print("=" * 60)
    print()

except Exception as e:

    UPLOAD_KEY = None

    print()
    print("=" * 60)
    print("无法读取测试密钥")
    print("=" * 60)
    print(str(e))
    print("=" * 60)
    print()


# ============================================================
# 安全检查
# ============================================================

def check_key():

    if UPLOAD_KEY is None:

        return False

    client_key = (
        request.headers.get("X-Upload-Key")
        or request.args.get("key")
        or request.form.get("key")
    )

    if not client_key:
        return False

    return client_key == UPLOAD_KEY


def require_key():

    if not check_key():

        return jsonify({
            "ok": False,
            "error": "无效的上传密钥"
        }), 401

    return None


# ============================================================
# 路径处理
# ============================================================

def safe_path(relative_path):
    """
    将网页输入的目录转换成服务器安全路径。
    禁止 ../ 等路径穿越。
    """

    if relative_path is None:
        relative_path = ""

    relative_path = str(
        relative_path
    ).strip()

    relative_path = relative_path.replace(
        "\\",
        "/"
    )

    # 删除开头 /
    relative_path = relative_path.lstrip("/")

    # 空目录
    if not relative_path:
        return BASE_DIR.resolve()

    parts = []

    for part in relative_path.split("/"):

        if not part:
            continue

        if part in (".", ".."):
            raise ValueError(
                "非法目录"
            )

        # Windows 下禁止盘符
        if ":" in part:
            raise ValueError(
                "非法路径"
            )

        parts.append(part)

    result = (
        BASE_DIR /
        Path(*parts)
    ).resolve()

    if not str(result).startswith(
        str(BASE_DIR.resolve())
    ):
        raise ValueError(
            "非法路径"
        )

    return result


def safe_filename(filename):

    filename = str(
        filename
    ).strip()

    if not filename:
        raise ValueError(
            "文件名为空"
        )

    filename = filename.replace(
        "\\",
        "/"
    )

    filename = Path(
        filename
    ).name

    if filename in (
        "",
        ".",
        ".."
    ):
        raise ValueError(
            "非法文件名"
        )

    return filename


