@app.route("/api/status")
def api_status():

    auth = require_key()

    if auth:
        return auth

    return jsonify({
        "ok": True,
        "max_file_size": MAX_FILE_SIZE,
        "max_file_size_gb": 10,
        "chunk_size": CHUNK_SIZE
    })


# ============================================================
# 查询上传状态
# ============================================================

@app.route(
    "/api/upload/status",
    methods=["GET"]
)
def upload_status():

    auth = require_key()

    if auth:
        return auth


    upload_id = (
        request.args.get(
            "upload_id"
        )
    )

    if not upload_id:

        return jsonify({
            "ok": False,
            "error": "缺少 upload_id"
        }), 400


    upload_dir = (
        TEMP_DIR /
        upload_id
    )


    meta_file =
        upload_dir / "meta.json"


    if not meta_file.exists():

        return jsonify({
            "ok": True,
            "exists": False,
            "uploaded": 0,
            "chunks": []
        })


    try:

        meta = json.loads(
            meta_file.read_text(
                encoding="utf-8"
            )
        )

    except Exception:

        return jsonify({
            "ok": False,
            "error": "上传任务损坏"
        }), 500


    chunks = []

    for path in upload_dir.glob(
        "chunk_*"
    ):

        match = re.match(
            r"chunk_(\d+)$",
            path.name
        )

        if match:

            chunks.append(
                int(match.group(1))
            )


    chunks.sort()


    return jsonify({

        "ok": True,

        "exists": True,

        "upload_id": upload_id,

        "filename":
            meta["filename"],

        "size":
            meta["size"],

        "directory":
            meta["directory"],

        "chunk_size":
            meta["chunk_size"],

        "total_chunks":
            meta["total_chunks"],

        "chunks":
            chunks

    })


# ============================================================
# 创建上传任务
# ============================================================

@app.route(
    "/api/upload/create",
    methods=["POST"]
)
def upload_create():

    auth = require_key()

    if auth:
        return auth


    data = request.get_json(
        silent=True
    ) or {}


    filename =
        data.get("filename")


    directory =
        data.get("directory", "")


    size =
        data.get("size")


    if not filename:

        return jsonify({
            "ok": False,
            "error": "缺少文件名"
        }), 400


    if size is None:

        return jsonify({
            "ok": False,
            "error": "缺少文件大小"
        }), 400


    try:

        size = int(size)

    except Exception:

        return jsonify({
            "ok": False,
            "error": "文件大小错误"
        }), 400


    if size < 0:

        return jsonify({
            "ok": False,
            "error": "文件大小错误"
        }), 400


    if size > MAX_FILE_SIZE:

        return jsonify({
            "ok": False,
            "error": "文件超过 10GB 限制"
        }), 413


    try:

        filename =
            safe_filename(
                filename
            )

        target_dir =
            safe_path(
                directory
            )

    except ValueError as e:

        return jsonify({
            "ok": False,
            "error": str(e)
        }), 400


    # 客户端可以提供 upload_id
    upload_id =
        data.get(
            "upload_id"
        )


    if not upload_id:

        upload_id =
            uuid.uuid4().hex


    # 只允许安全的 UUID 字符
    if not re.fullmatch(
        r"[a-zA-Z0-9_-]{8,100}",
        upload_id
    ):

        return jsonify({
            "ok": False,
            "error": "非法 upload_id"
        }), 400


    upload_dir =
        TEMP_DIR / upload_id


    upload_dir.mkdir(
        parents=True,
        exist_ok=True
    )


    total_chunks =
        (
            size +
            CHUNK_SIZE -
            1
        ) // CHUNK_SIZE


    meta = {

        "upload_id":
            upload_id,

        "filename":
            filename,

        "directory":
            str(
                target_dir.relative_to(
                    BASE_DIR
                )
            ).replace(
                "\\",
                "/"
            ),

        "size":
            size,

        "chunk_size":
            CHUNK_SIZE,

        "total_chunks":
            total_chunks

    }


    (
        upload_dir /
        "meta.json"
    ).write_text(

        json.dumps(
            meta,
            ensure_ascii=False,
            indent=2
        ),

        encoding="utf-8"
    )


    return jsonify({

        "ok": True,

        "upload_id":
            upload_id,

        "chunk_size":
            CHUNK_SIZE,

        "total_chunks":
            total_chunks

    })


# ============================================================
# 上传一个分片
# ============================================================

@app.route(
    "/api/upload/chunk",
    methods=["POST"]
)
def upload_chunk():

    auth = require_key()

    if auth:
        return auth


    upload_id =
        request.args.get(
            "upload_id"
        )


    chunk_index =
        request.args.get(
            "chunk"
        )


    if not upload_id:

        return jsonify({
            "ok": False,
            "error": "缺少 upload_id"
        }), 400


    if chunk_index is None:

        return jsonify({
            "ok": False,
            "error": "缺少 chunk"
        }), 400


    try:

        chunk_index =
            int(chunk_index)

    except Exception:

        return jsonify({
            "ok": False,
            "error": "chunk 错误"
        }), 400


    upload_dir =
        TEMP_DIR / upload_id


    meta_file =
        upload_dir / "meta.json"


    if not meta_file.exists():

        return jsonify({
            "ok": False,
            "error": "上传任务不存在"
        }), 404


    meta = json.loads(
        meta_file.read_text(
            encoding="utf-8"
        )
    )


    if (
        chunk_index < 0
        or
        chunk_index >=
        meta["total_chunks"]
    ):

        return jsonify({
            "ok": False,
            "error": "分片编号错误"
        }), 400


    chunk_file =
        upload_dir /
        f"chunk_{chunk_index}"


    # 如果这个分片已经存在
    # 直接覆盖
    with open(
        chunk_file,
        "wb"
    ) as f:

        while True:

            data =
                request.stream.read(
                    1024 * 1024
                )

            if not data:
                break

            f.write(data)


    return jsonify({

        "ok": True,

        "chunk":
            chunk_index,

        "size":
            chunk_file.stat().st_size

    })


# ============================================================
# 合并文件
# ============================================================

@app.route(
    "/api/upload/complete",
    methods=["POST"]
)
def upload_complete():

    auth = require_key()

    if auth:
        return auth


    data =
        request.get_json(
            silent=True
        ) or {}


    upload_id =
        data.get(
            "upload_id"
        )


    if not upload_id:

        return jsonify({
            "ok": False,
            "error": "缺少 upload_id"
        }), 400


    upload_dir =
        TEMP_DIR / upload_id


    meta_file =
        upload_dir / "meta.json"


    if not meta_file.exists():

        return jsonify({
            "ok": False,
            "error": "上传任务不存在"
        }), 404


    meta = json.loads(
        meta_file.read_text(
            encoding="utf-8"
        )
    )


    total_chunks =
        meta["total_chunks"]


    # 检查所有分片
    for i in range(
        total_chunks
    ):

        chunk_file =
            upload_dir /
            f"chunk_{i}"


        if not chunk_file.exists():

            return jsonify({

                "ok": False,

                "error":
                    f"缺少第 {i + 1} 个分片",

                "chunk":
                    i

            }), 400


    try:

        target_dir =
            safe_path(
                meta["directory"]
            )


        target_dir.mkdir(
            parents=True,
            exist_ok=True
        )


        final_file =
            target_dir /
            meta["filename"]


        temp_final =
            target_dir /
            (
                "." +
                meta["filename"] +
                "." +
                upload_id +
                ".uploading"
            )


        # 合并
        with open(
            temp_final,
            "wb"
        ) as output:

            for i in range(
                total_chunks
            ):

                chunk_file =
                    upload_dir /
                    f"chunk_{i}"


                with open(
                    chunk_file,
                    "rb"
                ) as source:

                    shutil.copyfileobj(
                        source,
                        output,
                        length=
                        1024 * 1024
                    )


        # 检查最终大小
        final_size =
            temp_final.stat().st_size


        if final_size != meta["size"]:

            try:
                temp_final.unlink()
            except Exception:
                pass

            return jsonify({

                "ok": False,

                "error":
                    "合并后文件大小不正确",

                "expected":
                    meta["size"],

                "actual":
                    final_size

            }), 500


        # 原子替换
        os.replace(
            temp_final,
            final_file
        )


        # 删除临时分片
        shutil.rmtree(
            upload_dir,
            ignore_errors=True
        )


        return jsonify({

            "ok": True,

            "filename":
                meta["filename"],

            "directory":
                meta["directory"],

            "size":
                final_size,

            "path":
                str(
                    final_file
                    .relative_to(
                        BASE_DIR
                    )
                ).replace(
                    "\\",
                    "/"
                )

        })


    except Exception as e:

        return jsonify({

            "ok": False,

            "error":
                str(e)

        }), 500


# ============================================================
# 服务器已有文件列表
#
# 注意：
# 这里只给文件名和大小。
# 不提供下载接口。
# ============================================================

@app.route(
    "/api/files",
    methods=["GET"]
)
def list_files():

    auth = require_key()

    if auth:
        return auth


    directory =
        request.args.get(
            "directory",
            ""
        )


    try:

        target_dir =
            safe_path(
                directory
            )

    except ValueError as e:

        return jsonify({
            "ok": False,
            "error": str(e)
        }), 400


    if not target_dir.exists():

        return jsonify({

            "ok": True,

            "files": []

        })


    if not target_dir.is_dir():

        return jsonify({

            "ok": False,

            "error":
                "指定路径不是目录"

        }), 400


    result = []


    for path in target_dir.iterdir():

        if not path.is_file():
            continue

        try:

            size =
                path.stat().st_size

        except Exception:

            size = 0


        result.append({

            "name":
                path.name,

            "size":
                size

        })


    result.sort(
        key=lambda x:
        x["name"].lower()
    )


    return jsonify({

        "ok": True,

        "files":
            result

    })


# ============================================================
# 不提供下载
# 不提供删除
# ============================================================


@app.errorhandler(
    413
)
def too_large(error):

    return jsonify({

        "ok": False,

        "error":
            "请求或文件超过服务器允许大小"

    }), 413


