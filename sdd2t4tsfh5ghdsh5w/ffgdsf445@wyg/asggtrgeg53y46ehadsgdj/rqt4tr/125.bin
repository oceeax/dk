# ============================================================
# 测试密钥
# ============================================================

def get_github_file_download_url():
    """
    从 GitHub 公共 API 获取 ad.zip 的下载地址。
    不需要 GitHub Token，因为仓库是公开的。
    """

    api_url = (
        "https://api.github.com/repos/"
        + GITHUB_USER
        + "/"
        + GITHUB_REPO
        + "/contents/"
        + "/".join(
            part.replace(" ", "%20")
            for part in GITHUB_FILE_PATH.split("/")
        )
        + "?ref="
        + GITHUB_BRANCH
    )

    req = Request(
        api_url,
        headers={
            "User-Agent": "GitHub-Test-Upload-Server"
        }
    )

    with urlopen(req, timeout=30) as response:
        data = json.loads(
            response.read().decode("utf-8")
        )

    download_url = data.get("download_url")

    if not download_url:
        raise RuntimeError(
            "GitHub 没有返回 ad.zip 的 download_url"
        )

    return download_url


def extract_test_key_from_zip():
    """
    测试版密钥提取规则：

    1. 下载 GitHub 上的 ad.zip
    2. 解压到临时目录
    3. 找第一个 UTF-8 文本文件
    4. 读取第三行
    5. 从第 5 个字符开始取 9 个字符

    注意：
    这是测试鉴权，不是真正安全的密钥。
    """

    download_url = get_github_file_download_url()

    temp_zip = TEMP_DIR / "_secret_ad.zip"

    req = Request(
        download_url,
        headers={
            "User-Agent": "GitHub-Test-Upload-Server"
        }
    )

    with urlopen(req, timeout=120) as response:
        with open(temp_zip, "wb") as f:
            while True:
                chunk = response.read(1024 * 1024)

                if not chunk:
                    break

                f.write(chunk)

    extract_dir = TEMP_DIR / "_secret_extract"

    if extract_dir.exists():
        shutil.rmtree(extract_dir)

    extract_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    try:

        with zipfile.ZipFile(temp_zip, "r") as z:

            # 防止 ZIP 路径穿越
            for info in z.infolist():

                target =
                (
                    extract_dir /
                    info.filename
                ).resolve()

                if not str(target).startswith(
                    str(extract_dir.resolve())
                ):
                    raise RuntimeError(
                        "ad.zip 包含非法路径"
                    )

            z.extractall(extract_dir)

    except zipfile.BadZipFile:

        raise RuntimeError(
            "ad.zip 不是有效 ZIP 文件"
        )

    finally:

        try:
            temp_zip.unlink()
        except Exception:
            pass


    # 找文本文件
    text_files = []

    for path in extract_dir.rglob("*"):

        if not path.is_file():
            continue

        try:

            data = path.read_text(
                encoding="utf-8"
            )

            text_files.append(
                (path, data)
            )

        except UnicodeDecodeError:
            continue

        except Exception:
            continue


    if not text_files:

        raise RuntimeError(
            "ad.zip 中没有找到 UTF-8 文本文件"
        )


    # 使用第一个 UTF-8 文本文件
    text = text_files[0][1]

    lines = text.splitlines()


    if len(lines) < 3:

        raise RuntimeError(
            "文本文件不足三行"
        )


    third_line = lines[2]


    # Python 字符串按 Unicode 字符计算
    if len(third_line) < 13:

        raise RuntimeError(
            "第三行不足 13 个字符，"
            "无法从第 5 个字符开始取 9 个字符"
        )


    # 第 5 个字符 = Python 下标 4
    key = third_line[4:13]


    if len(key) != 9:

        raise RuntimeError(
            "提取出来的测试密钥不是 9 个字符"
        )


    return key


# ============================================================
# 启动时读取测试密钥
# ============================================================

try:

    UPLOAD_KEY = extract_test_key_from_zip()

